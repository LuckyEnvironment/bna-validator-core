{
  "name": "@bna/validator-core",
  "version": "0.1.0",
  "description": "Shared BNA card validation core",
  "type": "module",
  "main": "src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "types/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc --project tsconfig.declarations.json",
    "prepack": "npm run build:types",
    "test:package": "node --test test/package.test.js",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^9.39.1",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3"
  }
}
